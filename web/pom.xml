<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.company</groupId>
    <artifactId>floorplan-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>floorplan-web</artifactId>
  <name>Floorplan :: Web</name>
  <description>接口层：REST 接口、统一响应与异常处理、应用启动入口</description>

  <dependencies>
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>floorplan-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>floorplan-infrastructure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- T1-5（B1）：跨服务 Feign 契约（CollateralClient）。common 反向依赖 application，
         故只能由最外层 web 引入，application/infrastructure 保持不依赖 common。 -->
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>floorplan-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- T1-5（B1）启动期依赖补齐（2026-11-22 PM 集成修复）：
         @EnableFeignClients 扫描到的 CollateralClient 用 name="collateral-reg-service" 且无 url，
         FeignClientFactoryBean.loadBalance() 必须能拿到 LoadBalancerClient，否则启动即抛
         "No Feign Client for loadBalancing defined"。common 只声明了 openfeign，
         gateway 已单独引了 loadbalancer，web 作为唯一启用 Feign 的模块必须自己补上。
         版本由 spring-cloud BOM 统一管理。 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>
    <!-- 安全基线单测：web 版 GlobalExceptionHandler 不泄露内部异常信息 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.company.floorplan.web.FloorplanApplication</mainClass>
        </configuration>
        <!-- 自定义 parent（非 spring-boot-starter-parent）需显式绑定 repackage -->
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
